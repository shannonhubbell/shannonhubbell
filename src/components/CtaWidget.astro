---
// src/components/CtaWidget.astro
---
<nav id="cta-widget">

    <ul>
        <li><a href="/contact">Contact Me!</a></li>
    </ul>

</nav>
<style>
    #cta-widget {
        position: fixed;
        top: 0;
        right: 0;
        background: var(--highlight-color);
        padding: 1rem;
        border-bottom-left-radius: 8px;
        ul {
            list-style: none;
            margin: 0;
            padding: 0;
            a {
                color: var(--bg-color);
                text-decoration: none;
                font-weight: bold;
                display: inline-block;
                transition: 0.5s;
                &:hover {
                    transform: scale(1.1);
                }
            }
        }
    }
</style>