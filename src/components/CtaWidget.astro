---
// src/components/CtaWidget.astro
---

<nav id="cta-widget">
    <ul>
        <li><a href="/contact">Contact Me!</a></li>
    </ul>
</nav>
<style>
    #cta-widget {
        position: fixed;
        z-index: 1000;
        top: 0;
        right: 0;
        background: var(--highlight-color);
        padding: 1rem;
        border-bottom-left-radius: 8px;
        font-size: 1rem !important;
        line-height: 100% !important;
        ul {
            list-style: none;
            margin: 0;
            padding: 0;
            font-size: 1rem !important;
            line-height: 100% !important;
            a {
                color: var(--bg-color);
                text-decoration: none;
                font-weight: bold;
                display: inline-block;
                transition: 0.5s;
                font-size: 1rem;
                line-height: 100%;
                &:hover {
                    transform: scale(1.1);
                }
            }
        }
    }
</style>
