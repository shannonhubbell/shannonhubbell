---
// src/components/PageHeader.astro

---
<header class="layout">
    <a href="/">Shannon Hubbell</a> <span>/</span> Modern websites, remarkably human.
</header>

<style>

    header {
        padding: 4rem 0;
        font-size: 1.5rem;
        text-transform: lowercase;
        line-height: 140%;
        a {
            font-size: 4rem;
            font-weight: bold;
            text-decoration: none;
            text-transform: none;
        }
        @media screen and (max-width: 1100px) {
            text-wrap: pretty;
            a {
                display: block;
                line-height: 105%;
                margin-bottom: .5rem;
            }
            span {
                display: none;
            }
        }
    }
</style>