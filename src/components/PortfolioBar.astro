---
// src/components/PortfolioBar.astro
const { title, description } = Astro.props;
---

<nav id="portfolio-bar">
    <div class="inner">
        {
            title && (
                <div class="title">
                    <>
                        <strong>{title}:</strong>
                        <br />
                    </>
                    {description}
                </div>
            )
        }

        <a href="https://shannonhubbell.com/portfolio" class="back">
            View Shannon Hubbell's Portfolio</a
        >
    </div>
</nav>

<style>
    #portfolio-bar {
        background: radial-gradient(
            circle,
            rgba(51, 51, 51, 1) 0%,
            rgba(0, 0, 0, 1) 100%
        );
        border-bottom: 1px solid #9f87af;
        font-family: "Lexend", sans-serif;
        width: 100%;
        z-index: 1000;
        padding: 1rem 0;
        color: #ccc;
        .inner {
            margin: 0 auto;
            width: 1300px;
            max-width: calc(100% - 2em);
        }
        .title {
            color: #fff;
            line-height: 140%;
            strong {
                font-weight: bold;
            }
        }
        a {
            width: 50%;
            color: rgba(255, 128, 128, 1);
            display: inline-block;
            margin-top: 0.5rem;
            font-size: 0.9rem;
            text-decoration: none;
            &:hover {
                text-decoration: underline;
            }
        }
    }
</style>
