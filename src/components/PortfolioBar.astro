---
const { title, description } = Astro.props;
---

<nav id="portfolio-bar">
    <div class="inner">
        <a href="/portfolio" class="back"> Back to Portfolio</a>
        <a href="/" class="home">SH</a>
    </div>
    <div class="inner">
        {
            title && (
                <div class="title">
                    <>
                        <strong>{title}:</strong>
                        <br />
                    </>
                    {description}
                </div>
            )
        }
    </div>
</nav>

<style>
    #portfolio-bar {
        background: radial-gradient(circle, rgba(51, 51, 51, 1) 0%, rgba(0, 0, 0, 1) 100%);
        border-bottom: 1px solid #9f87af;
        font-family: "Lexend", sans-serif;
        width: 100%;
        z-index: 1000;
        padding: 1rem 0;
        color: #CCC;
        .inner {
            margin: 0 auto;
            width: 1200px;
            max-width: calc(100% - 2em);
            display: flex;
        }
        .title {
            color: #FFF;
            margin: 1rem 0;
            line-height: 140%;
            strong {
                font-weight: bold;
            }
        }
        a {
            width: 50%;
            color: rgba(255, 128, 128, 1);
            text-decoration: none;
            &.back {
                &::before {
                    content: "←";
                }
            }
            &.home {
                text-align: right;
                font-weight: bold;
            }
        }
    }
</style>
