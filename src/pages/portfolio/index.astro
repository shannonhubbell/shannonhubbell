---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import Footer from "../../components/Footer.astro";

import Headshot from "../assets/headshot.webp";
import LinkedIn from "../assets/linkedin.svg";

const title = "Shannon Hubbell's Portfolio";
const description =
	"Consulting, design, development, hosting. H and-crafted, free range, organic web sites. No AI.";
---

<Layout title={title} description={description}>
	<PageHeader />
	<main>
		<div class="layout">
			<h1>Portfolio</h1>

			<ul id="portfolio-items">
				<li>
					<a
						href="https://athena-squad.netlify.app/"
						data-tooltip="Website for an educational non-profit organization."
						style="background-image: url('/portfolio-assets/athena-squad/thumb.webp');"
					>
						<article>
							<h2>Athena Squad</h2>
						</article>
					</a>
				</li>
				<li>
					<a
						href="https://spot-vallette.netlify.app/"
						data-tooltip="Restaurant site with an animated header and editable menu."
						style="background-image: url('/portfolio-assets/spot-vallette/thumb.webp');"
					>
						<article>
							<h2>Spot Vallette</h2>
						</article>
					</a>
				</li>
				<li>
					<a
						href="https://heroncon.netlify.app/"
						data-tooltip="Conference site with calendar of events, event descriptions, and speaker bios"
						style="background-image: url('/portfolio-assets/heroncon/thumb.webp');"
					>
						<article>
							<h2>HeronCon 2026</h2>
						</article>
					</a>
				</li>
				<li>
					<a
						href="/portfolio/presidio/coffee-in-the-cloud/aramark"
						data-tooltip="Personalized 'coffee of the month' web campaign."
						style="background-image: url(/portfolio-assets/presidio/coffee-in-the-cloud/thumb.webp);"
					>
						<article>
							<h2>Cisco & Presidio</h2>
						</article>
					</a>
				</li>
				<li>
					<a
						href="https://www.adobe-audience-finder.com/"
						data-tooltip="A filterable and searchable directory of Adobe data partners, built in Wordpress."
						style="background-image: url(/portfolio-assets/adobe/audience-finder/thumb.webp);"
						target="_blank"
					>
						<article>
							<h2>Adobe</h2>
						</article>
					</a>
				</li>
				<li>
					<a
						href="/portfolio/envase"
						data-tooltip="Marketing microsite for a cloud-based, comprehensive drayage system."
						style="background-image: url('/portfolio-assets/envase/thumb.webp');"
					>
						<article>
							<h2>Envase Lite</h2>
						</article>
					</a>
				</li>
				<li>
					<a
						href="/portfolio/cepheid"
						data-tooltip="Marketing microsite for a medical diagnostics company specializing in DNA testing."
						style="background-image: url('/portfolio-assets/cepheid/thumb.webp');"
					>
						<article>
							<h2>Cepheid</h2>
						</article>
					</a>
				</li>
				<li>
					<a
						href="/portfolio/viewstream/paso-webinar"
						data-tooltip="Landing page for digital marketing framework webinar."
						style="background-image: url(/portfolio-assets/viewstream/paso-webinar/thumb.webp)"
					>
						<article>
							<h2>Viewstream</h2>
						</article>
					</a>
				</li>
				<li>
					<a
						href="/portfolio/2goodcompany"
						data-tooltip="Website for a digital marketing, streaming, and live event agency."
						style="background-image: url(/portfolio-assets/2goodcompany/thumb.webp);"
					>
						<article>
							<h2>Good Company</h2>
						</article>
					</a>
				</li>
				<li>
					<a
						href="/portfolio/salesforce-ipad"
						data-tooltip="Interactive 'giant iPad' for Dreamforce."
						style="background-image: url(/portfolio-assets/salesforce-ipad/thumb.webp);"
					>
						<article>
							<h2>Salesforce iPad</h2>
						</article>
					</a>
				</li>
			</ul>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	main {
		padding-bottom: 2rem;
		.layout {
			h1 {
				font-size: 3rem;
				font-weight: normal;
			}
		}
	}
	#portfolio-items {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		list-style: none;
		margin: 0;
		padding: 0;
		@media screen and (max-width: 1100px) {
			grid-template-columns: repeat(3, 1fr);
		}
		@media screen and (max-width: 700px) {
			grid-template-columns: repeat(2, 1fr);
		}
		@media screen and (max-width: 400px) {
			grid-template-columns: repeat(1, 1fr);
		}
		li {
			margin: 0;
			padding: 0;
			border: 1px solid var(--bg-color);
			a {
				display: block;
				background-repeat: no-repeat;
				background-size: cover;
				aspect-ratio: 1;
				position: relative;
				&::after {
					content: attr(data-tooltip);
					position: absolute;
					top: 1rem;
					left: 1rem;
					padding: 0.5rem;
					width: calc(100% - 3rem);
					background: rgba(0, 0, 0, 0.75);
					backdrop-filter: blur(5);
					opacity: 0;
					transition: all 1s;
					color: var(--text-color);
					@media screen and (max-width: 400px) {
						opacity: 1;
					}
				}
				&:hover {
					&::after {
						opacity: 1;
					}
				}
				article {
					position: absolute;
					bottom: 1rem;
					left: 1rem;
					padding: 0.5rem;
					width: calc(100% - 3rem);
					background: rgba(0, 0, 0, 0.75);
					backdrop-filter: blur(5);
				}
				h2 {
					margin: 0;
					font-weight: normal;
				}
			}
		}
	}
</style>
