---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Footer from "../components/Footer.astro";

import { actions } from "astro:actions";
// Handle fallback if JavaScript is disabled on the client
const result = Astro.getActionResult(actions.sendEmail);

import Headshot from "../assets/headshot.webp";
import LinkedIn from "../assets/linkedin.svg";

const title = "Shannon Hubbell - Contact Me";
const description =
	"Web design, development, hosting & consulting. Modern websites, remarkably human.";
---

<Layout title={title} description={description}>
	<PageHeader />
	<main>
		<div class="layout">
			<div id="contact-form">
				{
					result?.data?.success && (
						<div class="alert success">
							Your message has been sent successfully!
						</div>
					)
				}
				{
					result?.error && (
						<div class="alert error">
							Failed to send message: {result.error.message}
						</div>
					)
				}

				<form
					method="POST"
					action={actions.sendEmail}
					class="contact-form"
				>
					<div class="form-group">
						<label for="name">Name</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							minlength="2"
						/>
					</div>

					<div class="form-group">
						<label for="email">Email Address</label>
						<input type="email" id="email" name="email" required />
					</div>

					<div class="form-group">
						<label for="message">Message</label>
						<textarea
							id="message"
							name="message"
							rows="5"
							required
							minlength="10"></textarea>
					</div>

					<button type="submit">Send Message</button>
				</form>
				<!--
				<iframe src="https://docs.google.com/forms/d/e/1FAIpQLSerC-P5a-hXl3n7KGneGs9-nDSID1pqE9vTGxflUhGva6VIqw/viewform?embedded=true" width="640" height="900" frameborder="0" marginheight="0" marginwidth="0">Loading…</iframe>
				<form name="contact" method="POST" data-netlify="true">
					<input type="hidden" name="form-name" value="contact" />
					<p>
						<label
							>Name <input
								type="text"
								name="name"
								placeholder="Your Name"
								required
							/></label
						>
					</p>
					<p>
						<label
							>Email <input
								type="email"
								name="email"
								placeholder="Your Email"
								required
							/></label
						>
					</p>
					<p>
						<label for="message"
							>Message
							<textarea name="message" rows="5" required
							></textarea>
						</label>
					</p>
					<p>
						<button type="submit">Send</button>
					</p>
				</form>
			-->
			</div>
			<div id="contact-extra">
				<img
					src={Headshot.src}
					alt="Shannon Hubbell's ugly mug"
					class="headshot"
				/>

				<ul class="links">
					<li>
						<a href="/portfolio" class="cta"> Portfolio </a>
					</li>
					<li>
						<a href="/resume" class="cta"> Resumé </a>
					</li>
					<li>
						<a href="mailto:shannon.hubbell@gmail.com"
							>shannon.hubbell@gmail.com</a
						>
					</li>
					<li>
						<a href="tel:+14158582683">+1 (415) 858-2683</a>
					</li>
					<li>
						<a
							href="https://www.linkedin.com/in/shannonhubbell"
							target="_blank"
						>
							<img
								src={LinkedIn.src}
								alt="LinkedIn Logo"
								class="social"
							/>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	main {
		padding-bottom: 2rem;
		.layout {
			display: flex;
			justify-content: space-between;
			flex-wrap: wrap;
		}
	}
	#contact-form {
		width: calc(70% - 4rem);
		padding: 0 2rem;
		background: var(--text-color);
		color: var(--bg-color);
		border-radius: 8px;
		padding: 2rem;
		@media screen and (max-width: 1100px) {
			width: 100%;
		}
		h2 {
			font-weight: normal;
		}
		iframe {
			max-width: 100%;
		}
		.form-group {
			margin: .5rem 0;
		}
		input,
		textarea {
			border: 1px solid var(--bg-color);
			padding: 0.5rem;
			width: calc(100% - 1rem);
			font-size: 1rem;
			line-height: 140%;
			border-radius: 8px;
			margin-top: 0.25rem;
		}
		button {
			background-color: var(--highlight-color);
			color: var(--bg-color);
			padding: 0.5rem 1rem;
			width: auto;
			font-size: 1rem;
			line-height: 140%;
			border-radius: 8px;
			margin-top: 0.25rem;
			cursor: pointer;
			font-size: 1.25rem;
			font-weight: bold;
			border: none;
		}
		.alert {
			padding: 1rem;
			border-radius: 4px;
			margin-bottom: 1.5rem;
		}
		.success {
			background-color: #e6f4ea;
			color: #137333;
		}
		.error {
			background-color: #fce8e6;
			color: #c5221f;
		}
	}
	#contact-extra {
		width: calc(30% - 3rem);
		@media screen and (max-width: 1100px) {
			width: 100%;
			text-align: center;
			img.headshot {
				display: none;
			}
		}
		img.headshot {
			max-width: 100%;
			border-top-left-radius: 50%;
			border-bottom-right-radius: 50%;
			border: 1px solid var(--text-color);
		}
		ul.links {
			list-style: none;
			margin: 1rem 0 0 0;
			padding: 0;
			font-size: 1.25rem;
			a {
				text-decoration: none;
				&.cta {
					display: block;
					padding: 0.5rem 1rem;
					background: var(--highlight-color);
					color: var(--bg-color);
					border-radius: 8px;
					transition: all 0.5s;
					transform: scale(1);
					&:hover {
						transform: scale(1.05);
					}
				}
			}
			li {
				margin: 0;
				padding: 0.5rem 0;
			}
		}
		img.social {
			width: 50px;
		}
	}
</style>
