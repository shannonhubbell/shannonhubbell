---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Footer from "../components/Footer.astro";

import Headshot from "../assets/headshot.webp";

const title = "Shannon Hubbell - Web guy in Oakland, CA";
const description =
	"Consulting, design, development, hosting. No AI. Just hand-crafted, free range, organic web sites.";
---

<Layout title={title} description={description}>
	<PageHeader />
	<main>
		<div class="layout">
			<div id="contact-form">
				<h2>Let's work together. Drop me a line!</h2>
				<form name="contact" method="POST" data-netlify="true">
					<input type="hidden" name="form-name" value="contact" />
					<p>
						<label
							>Name <input
								type="text"
								name="name"
								placeholder="Your Name"
								required
							/></label
						>
					</p>
					<p>
						<label
							>Email <input
								type="email"
								name="email"
								placeholder="Your Email"
								required
							/></label
						>
					</p>
					<p>
						<label for="message"
							>Message
							<textarea name="message" rows="5" required
							></textarea>
						</label>
					</p>
					<p>
						<button type="submit">Send</button>
					</p>
				</form>
			</div>
			<div id="contact-extra">
				<ul>
					<li>
						<img
							src={Headshot.src}
							alt="Shannon Hubbell's ugly mug"
						/>
					</li>
					<li>
						
					</li>
					<li>
						<ul class="links">
							<li>☎ <a href="tel:+14158582683">+1(415)858-2683</a></li>
							<li>📧 <a href="mailto:shannon.hubbell@gmail.com">shannon.hubbell@gmail.com</a></li>
						</ul>
					</li>
				</ul>
			</div>
		</div>
	</main>
	<Footer />
</Layout>

<style>
	main {
		padding-bottom: 2rem;
		.layout {
			display: flex;
			justify-content: space-between;
		}
	}
	#contact-form {
		width: calc(50% - 4rem);
		padding: 0 2rem;
		background: var(--text-color);
		color: var(--bg-color);
		border-radius: 8px;
		padding: 2rem;
		h2 {
			font-weight: normal;
		}
		input,
		textarea {
			border: 1px solid var(--bg-color);
			padding: 0.5rem;
			width: calc(100% - 1rem);
			font-size: 1rem;
			line-height: 140%;
			border-radius: 8px;
			margin-top: 0.25rem;
		}
		button {
			background-color: var(--bg-color);
			color: var(--text-color);
			padding: 0.5rem;
			width: calc(100% - 1rem);
			font-size: 1rem;
			line-height: 140%;
			border-radius: 8px;
			margin-top: 0.25rem;
			cursor: pointer;
			font-size: 1rem;
		}
	}
	#contact-extra {
		width: calc(50% - 2rem);
		> ul {
			list-style: none;
			margin: 0;
			padding: 0;
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem;
			ul.links {
				list-style: none;
				margin: 0;
				padding: 0;
				li {
					margin: 0;
					padding: 0;
				}
			}
			img {
				max-width: 100%;
				border-radius: 8px;
				border: 1px solid var(--text-color);
			}
		}
	}
</style>
