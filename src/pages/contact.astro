---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Footer from "../components/Footer.astro";
import "../styles/subpages.css";

import Headshot from "../assets/headshot.webp";
import LinkedIn from "../assets/linkedin.svg";

const title = "Shannon Hubbell - Contact Me";
const description =
	"Web design, development, hosting & consulting. Modern websites, remarkably human.";
---

<Layout title={title} description={description}>
	<PageHeader />
	<main class="subpage">
		<div class="layout">
			<div id="contact-form" class="panel panel--form">
				<h2>Let's work together. Drop me a line!</h2>
				<form name="contact" method="POST" action="https://formspree.io/f/xyewneog">
					<input type="hidden" name="form-name" value="contact" />
					<p>
						<label
							>Name <input
								type="text"
								name="name"
								placeholder="Your Name"
								required
							/></label
						>
					</p>
					<p>
						<label
							>Email <input
								type="email"
								name="email"
								placeholder="Your Email"
								required
							/></label
						>
					</p>
					<p>
						<label for="message"
							>Message
							<textarea name="message" rows="5" required
							></textarea>
						</label>
					</p>
					<p>
						<button type="submit">Send</button>
					</p>
				</form>
			</div>
			<div id="contact-extra" class="contact-extra">
				<img
					src={Headshot.src}
					alt="Shannon Hubbell's ugly mug"
					class="headshot"
				/>

				<ul class="links">
					<li>
						<a href="/portfolio" class="cta"> Portfolio </a>
					</li>
					<li>
						<a href="/resume" class="cta"> Resumé </a>
					</li>
					<li>
						<a href="mailto:shannon.hubbell@gmail.com"
							>shannon.hubbell@gmail.com</a
						>
					</li>
					<li>
						<a href="tel:+14158582683">+1 (415) 858-2683</a>
					</li>
					<li>
						<a
							href="https://www.linkedin.com/in/shannonhubbell"
							target="_blank"
						>
							<img
								src={LinkedIn.src}
								alt="LinkedIn Logo"
								class="social"
							/>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
