---
// src/pages/resume.astro
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import Footer from "../components/Footer.astro";
import "../styles/subpages.css";

import Headshot from "../assets/headshot.webp";
import LinkedIn from "../assets/linkedin.svg";

import * as resume from "../content/resume-text.md";
const { Content } = resume;

const title = "Shannon Hubbell's Resumé";
const description =
	"Web design, development, hosting & consulting. Modern websites, remarkably human.";
---

<Layout title={title} description={description}>
	<PageHeader />
	<main class="subpage">
		<div class="layout">
			<div id="resume" class="panel panel--prose">
				<Content />
			</div>
			<div id="contact-extra" class="contact-extra">
				<img src={Headshot.src} alt="Shannon Hubbell's ugly mug" class="headshot" />

				<ul class="links">
					<li>
						<a href="/portfolio" class="cta">
							Portfolio
						</a>
					</li>
					<li>
						<a href="mailto:shannon.hubbell@gmail.com"
							>shannon.hubbell@gmail.com</a
						>
					</li>
					<li>
						<a href="tel:+14158582683">+1 (415) 858-2683</a>
					</li>
					<li>
						<a href="https://www.linkedin.com/in/shannonhubbell" target="_blank">
							<img src={LinkedIn.src} alt="LinkedIn Logo" class="social">
						</a>
					</li>
				</ul>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
