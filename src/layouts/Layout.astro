---
// src/layouts/Layout.astro
import "../styles/general.css";
import "aos/dist/aos.css";
import { ClientRouter } from "astro:transitions";

import CtaWidget from "../components/CtaWidget.astro";
import BackToTop from "../components/BackToTop.astro";

const { title, description } = Astro.props;
const tabTitle = title ? title : "Shannon Hubbell";
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-9WRKBPV5XK"
		></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(...args: unknown[]) {
				window.dataLayer.push(args);
			}
			gtag("js", new Date());

			gtag("config", "G-9WRKBPV5XK");
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="og:title" content={title} />
		<meta name="og:description" content={description} />
		<meta name="description" content={description} />
		<meta name="og:image" content="/banner.png" />
		<link rel="canonical" href={Astro.url} />
		<meta name="og:url" content={Astro.url} />
		<meta name="og:site_name" content="Shannon Ellery Hubbell" />
		<meta name="author" content="Shannon Ellery Hubbll" />
		<meta name="twitter:card" content="summary_large_image" />

		<title>{tabTitle}</title>
		<ClientRouter />
	</head>
	<body data-theme="friendly">
		<div id="scroll-sentinel"></div>
		<CtaWidget />
		<slot />
		<BackToTop />
		<script>
			import AOS from "aos";
			AOS.init();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
